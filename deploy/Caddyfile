# Caddyfile — reverse proxy de produção do LGD Mantos.
#
# Responsabilidades:
#   1. HTTPS automático (Let's Encrypt) para o domínio definido em $DOMAIN.
#   2. Servir o PWA buildado (arquivos estáticos em /srv).
#   3. Encaminhar API e arquivos enviados para o backend FastAPI.
#
# O valor de {$DOMAIN} vem da variável de ambiente DOMAIN do container `web`
# (definida no .env da raiz do projeto).

{$DOMAIN} {
	# Compressão para respostas de texto (JS, CSS, JSON).
	encode gzip zstd

	# API FastAPI — todas as rotas versionadas vivem sob /api.
	handle /api/* {
		reverse_proxy backend:8000
	}

	# Fotos de produtos enviadas pelo módulo operacional.
	handle /uploads/* {
		reverse_proxy backend:8000
	}

	# Demais arquivos estáticos servidos pelo backend.
	handle /static/* {
		reverse_proxy backend:8000
	}

	# PWA React — fallback para index.html (roteamento client-side do SPA).
	handle {
		root * /srv
		try_files {path} /index.html
		file_server
	}
}
