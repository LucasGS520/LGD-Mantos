# Modelo de configuração de ambiente — copie para .env e preencha os valores.
# NUNCA commite o arquivo .env com valores reais.

# Conexão com o PostgreSQL (obrigatório).
# Formato: postgresql+asyncpg://usuario:senha@host:5432/nome_do_banco
DATABASE_URL=postgresql+asyncpg://postgres:SENHA_AQUI@db:5432/lgd_mantos

# Senha do PostgreSQL usada pelo container `db` em produção
# (docker-compose.prod.yml). Precisa ser a MESMA senha da DATABASE_URL acima.
POSTGRES_PASSWORD=SENHA_AQUI

# Senha de login do dono da loja no PWA (obrigatório).
APP_PASSWORD=defina-uma-senha-forte

# Segredo usado para assinar os tokens JWT (obrigatório).
# Gere um valor aleatório longo, ex.: openssl rand -hex 32
APP_SECRET=gere-um-segredo-aleatorio-longo

# Servidor Ollama usado pelos agentes de IA (opcional — padrão localhost).
OLLAMA_URL=http://ollama:11434
OLLAMA_MODEL=llama3.1:8b

# Origens permitidas para CORS, separadas por vírgula (opcional).
# Padrão: http://localhost:5173,http://127.0.0.1:5173
# Em produção (VPS com reverse proxy), frontend e API compartilham o mesmo
# domínio — inclua-o mesmo assim por segurança:
# CORS_ORIGINS=https://app.seudominio.com.br

# Domínio público do sistema em produção (usado pelo Caddy para HTTPS automático).
# Aponte um registro DNS tipo A deste domínio para o IP do VPS antes do deploy.
# DOMAIN=app.seudominio.com.br
