# Modelo de configuração de ambiente — copie para .env e preencha os valores.
# NUNCA commite o arquivo .env com valores reais.

# Conexão com o PostgreSQL (obrigatório).
# Formato: postgresql+asyncpg://usuario:senha@host:5432/nome_do_banco
DATABASE_URL=postgresql+asyncpg://lgd_app:SENHA_APP_DB@db:5432/lgd_mantos
MIGRATION_DATABASE_URL=postgresql+asyncpg://lgd_migrator:SENHA_MIGRATOR_DB@db:5432/lgd_mantos
BOOTSTRAP_DATABASE_URL=postgresql+asyncpg://postgres:SENHA_ADMIN_DB@db:5432/lgd_mantos
LGD_APP_PASSWORD=SENHA_APP_DB
LGD_MIGRATOR_PASSWORD=SENHA_MIGRATOR_DB

# Somente verificação local; nunca a base operacional.
# TEST_DATABASE_URL=postgresql+asyncpg://lgd_app:SENHA_APP_DB@localhost:55432/lgd_mantos_alignment_test
# TEST_MIGRATION_DATABASE_URL=postgresql+asyncpg://lgd_migrator:SENHA_MIGRATOR_DB@localhost:55432/lgd_mantos_alignment_test

# Senha do PostgreSQL usada pelo container `db` do Docker Compose.
# Usada somente no bootstrap administrativo, nunca pela API.
POSTGRES_PASSWORD=SENHA_ADMIN_DB

# Senha de login do dono da loja no frontend (obrigatório).
APP_PASSWORD=defina-uma-senha-forte

# Segredo usado para assinar os tokens JWT (obrigatório).
# Gere um valor aleatório longo, ex.: openssl rand -hex 32
APP_SECRET=gere-um-segredo-aleatorio-longo

# Limites por conexão/requisição. Valores positivos; não criam repetição automática.
# DB_LOCK_TIMEOUT_MS=5000
# DB_STATEMENT_TIMEOUT_MS=30000
# DB_POOL_TIMEOUT_SECONDS=5

# Identificador imutável da imagem de backend da release de produção.
# LGD_RELEASE=sha-do-commit

# Origens permitidas para CORS, separadas por vírgula (opcional).
# Padrão: http://localhost:5173,http://127.0.0.1:5173
# Se frontend e API forem publicados em domínios diferentes, inclua a origem
# pública do frontend:
# CORS_ORIGINS=https://app.seudominio.com.br

# Dom?nio p?blico para HTTPS autom?tico no docker-compose.prod.yml.
# DOMAIN=app.seudominio.com.br
